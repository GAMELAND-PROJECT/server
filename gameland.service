[Unit]
Description=GameLand CS 1.6 Dedicated Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStartPre=/usr/bin/tmux start-server
# Directly launch the startup script (it creates its own tmux session)
ExecStart=/opt/gameland/server/start.sh
ExecStop=/usr/bin/tmux kill-session -t gameland_server
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target

