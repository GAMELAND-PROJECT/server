[Unit]
Description=GameLand CS 1.6 Dedicated Server
After=network-online.target
Wants=network-online.target

[Service]
# ─── مسیر پروژه ── در صورت نیاز تغییر بدین ────────────────────
Environment="PROJECT_ROOT=/opt/gameland/server"
# ───────────────────────────────────────────────────────────────

Type=oneshot
RemainAfterExit=yes
User=root
WorkingDirectory=${PROJECT_ROOT}

# راه‌اندازی: اجرای سرور 18 اسلاته
ExecStart=/bin/bash ${PROJECT_ROOT}/start.sh

# استاپ: بستن کامل سرور و نشست‌ها
ExecStop=/bin/bash -c 'pkill -9 -f hlds_linux 2>/dev/null; pkill -9 -f hltv 2>/dev/null; tmux kill-session -t gameland_server 2>/dev/null; rm -f ${PROJECT_ROOT}/gameland.pid; true'

# ریستارت دستی (systemctl restart)
ExecReload=/bin/bash -c 'pkill -9 -f hlds_linux 2>/dev/null; pkill -9 -f hltv 2>/dev/null; tmux kill-session -t gameland_server 2>/dev/null; sleep 2; /bin/bash ${PROJECT_ROOT}/start.sh'


[Install]
WantedBy=multi-user.target
