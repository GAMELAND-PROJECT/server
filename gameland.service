[Unit]
Description=GameLand CS 1.6 Dedicated Server
After=network-online.target
Wants=network-online.target

[Service]
# ─── مسیر پروژه ── در صورت نیاز تغییر بدین ────────────────────
Environment="PROJECT_ROOT=/opt/gameland/server"
# ───────────────────────────────────────────────────────────────

Type=oneshot
RemainAfterExit=yes
User=root
WorkingDirectory=/opt/gameland/server

# ایزولاسیون کامل cgroup: عدم بستن پروسه‌های سایر سرویس‌ها یا دیمون‌های مشترک
KillMode=process
TimeoutSec=30

# راه‌اندازی: اجرای سرور
ExecStart=/bin/bash /opt/gameland/server/start.sh

# استاپ: بستن کامل نشست و پورت همین سرور (بدون دست زدن به سایر سرورها)
ExecStop=/bin/bash -c 'fuser -k 27015/udp 2>/dev/null; fuser -k 27015/tcp 2>/dev/null; fuser -k 27005/udp 2>/dev/null; tmux kill-session -t gameland_server 2>/dev/null; rm -f /opt/gameland/server/gameland.pid; true'

# ریستارت دستی (systemctl restart)
ExecReload=/bin/bash -c 'fuser -k 27015/udp 2>/dev/null; fuser -k 27015/tcp 2>/dev/null; fuser -k 27005/udp 2>/dev/null; tmux kill-session -t gameland_server 2>/dev/null; sleep 1; /bin/bash /opt/gameland/server/start.sh'


[Install]
WantedBy=multi-user.target
