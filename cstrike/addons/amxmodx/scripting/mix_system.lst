public RG_EndRound(WinStatus:status, ScenarioEventEndRound:event, Float:tmDelay)
{
	if(get_playersnum() < 1)
	{
		return
	}

	if(event == ROUND_GAME_RESTART || event == ROUND_GAME_COMMENCE)
	{
		if(g_eBooleans[bIsWarm])
		{
			set_task(0.5, "task_reapply_warm")
		}
		return
	}

