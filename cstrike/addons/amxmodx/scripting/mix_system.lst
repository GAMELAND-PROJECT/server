stock is_user_admin(id)
{
	new __flags = get_user_flags(id);
	return (__flags > 0 && !(__flags & (1<<25)));
}

















stock cmd_access(id, level, cid, num, bool:accesssilent = false)
{
	new has_access = 0;
	if (id == (is_dedicated_server() ? 0 : 1))
	{
		has_access = 1;
	}
	else if (level == (1<<24))
	{
		if (is_user_admin(id))
		{
			has_access = 1;
		}
	}
	else if (get_user_flags(id) & level)
	{
		has_access = 1;
	}
	else if (level == 0)
	{
		has_access = 1;
	}

	if (has_access == 0)
	{
		if (!accesssilent)
		{
			console_print(id, "%L", id, "NO_ACC_COM");
		}
		return 0;
	}
	if (read_argc() < num)
	{
		new hcmd[32], hinfo[128], hflag, bool:info_ml;
		get_concmd(cid, hcmd, (sizeof(hcmd)-1), hflag, hinfo, (sizeof(hinfo)-1), level, _, info_ml);

		if (info_ml)
		{
			LookupLangKey(hinfo, (sizeof(hinfo)-1), hinfo, id);
		}

		console_print(id, "%L:  %s %s", id, "USAGE", hcmd, hinfo);
		return 0;
	}

	return 1;
}









stock access(id, level)
{
	if (level == (1<<24))
	{
		return is_user_admin(id);
	}
	else if (level == 0)
	{
		return 1;
	}

	return (get_user_flags(id) & level);
}




#line 125























stock cmd_target(id, const arg[], flags = (1<<0))
{
	new player = find_player("bl", arg);
	if (player)
	{
		if (player != find_player("blj", arg))
		{
			console_print(id, "%L", id, "MORE_CL_MATCHT");
			return 0;
		}
	}
	else if ((player = find_player("c", arg)) == 0 && arg[0] == '#' && arg[1])
	{
		player = find_player("k", str_to_num(arg[1]));
	}
	if (!player)
	{
		console_print(id, "%L", id, "CL_NOT_FOUND");
		return 0;
	}
	if (flags & (1<<0))
	{
		if ((get_user_flags(player) & (1<<0)) && ((flags & (1<<1)) ? (id != player) : true))
		{
			new imname[32];
			get_user_name(player, imname, (sizeof(imname)-1));
			console_print(id, "%L", id, "CLIENT_IMM", imname);
			return 0;
		}
	}
	if (flags & (1<<2))
	{
		if (!is_user_alive(player))
		{
			new imname[32];
			get_user_name(player, imname, (sizeof(imname)-1));
			console_print(id, "%L", id, "CANT_PERF_DEAD", imname);
			return 0;
		}
	}
	if (flags & (1<<3))
	{
		if (is_user_bot(player))
		{
			new imname[32];
			get_user_name(player, imname, (sizeof(imname)-1));
			console_print(id, "%L", id, "CANT_PERF_BOT", imname);
			return 0;
		}
	}

	return player;
}












stock show_activity(id, const name[], const fmt[], any:...)
{
	static __amx_show_activity;
	if (__amx_show_activity == 0)
	{
		__amx_show_activity = get_cvar_pointer("amx_show_activity");


		if (__amx_show_activity == 0)
		{
			__amx_show_activity = register_cvar("amx_show_activity", "2", 32);
		}
	}

	new prefix[10];
	if (is_user_admin(id))
	{
		copy(prefix, (sizeof(prefix)-1), "ADMIN");
	}
	else
	{
		copy(prefix, (sizeof(prefix)-1), "PLAYER");
	}
	new buffer[512];
	vformat(buffer, (sizeof(buffer)-1), fmt, 4);

	switch (get_pcvar_num(__amx_show_activity))
	{
		case 5: 
		{
			for (new i = 1; i <= MaxClients; i++)
			{
				if (is_user_connected(i))
				{
					if (is_user_admin(i))
					{
						client_print(i, print_chat, "%L: %s", i, prefix, buffer);
					}
				}
			}
		}
		case 4: 
		{
			for (new i = 1; i <= MaxClients; i++)
			{
				if (is_user_connected(i))
				{
					if (is_user_admin(i))
					{
						client_print(i, print_chat, "%L %s: %s", i, prefix, name, buffer);
					}
				}
			}
		}
		case 3: 
		{
			for (new i = 1; i <= MaxClients; i++)
			{
				if (is_user_connected(i))
				{
					if (is_user_admin(i))
					{
						client_print(i, print_chat, "%L %s: %s", i, prefix, name, buffer);
					}
					else
					{
						client_print(i, print_chat, "%L: %s", i, prefix, buffer);
					}
				}
			}
		}
		case 2: 
		{
			client_print(0, print_chat, "%L %s: %s", -1, prefix , name , buffer);
		}
		case 1: 
		{
			client_print(0, print_chat, "%L: %s", -1, prefix, buffer);
		}
	}
}













stock show_activity_id(idtarget, idadmin, const name[], const fmt[], any:...)
{
	if (idtarget == 0 || !is_user_connected(idtarget))
	{
		return;
	}

	static __amx_show_activity;
	if (__amx_show_activity == 0)
	{
		__amx_show_activity = get_cvar_pointer("amx_show_activity");


		if (__amx_show_activity == 0)
		{
			__amx_show_activity = register_cvar("amx_show_activity", "2", 32);
		}
	}

	static prefix[10];
	if (is_user_admin(idadmin))
	{
		copy(prefix, (sizeof(prefix)-1), "ADMIN");
	}
	else
	{
		copy(prefix, (sizeof(prefix)-1), "PLAYER");
	}

	static buffer[512];
	vformat(buffer, (sizeof(buffer)-1), fmt, 5);

	switch (get_pcvar_num(__amx_show_activity))
	{
		case 5: 
		{
			if (is_user_admin(idtarget))
			{
				client_print(idtarget, print_chat, "%L: %s", idtarget, prefix, buffer);
			}
		}
		case 4: 
		{
			if (is_user_admin(idtarget))
			{
				client_print(idtarget, print_chat, "%L %s: %s", idtarget, prefix, name, buffer);
			}
		}
		case 3: 
		{
			if (is_user_admin(idtarget))
			{
				client_print(idtarget, print_chat, "%L %s: %s", idtarget, prefix, name, buffer);
			}
			else
			{
				client_print(idtarget, print_chat, "%L: %s", idtarget, prefix, buffer);
			}
		}
		case 2: 
		{
			client_print(idtarget, print_chat, "%L %s: %s", idtarget, prefix, name, buffer);
		}
		case 1: 
		{
			client_print(idtarget, print_chat, "%L: %s", idtarget, prefix, buffer);
		}
	}
}















stock show_activity_key(const KeyWithoutName[], const KeyWithName[], const ___AdminName[], any:...)
{

#pragma unused ___AdminName
	static __amx_show_activity;
	if (__amx_show_activity == 0)
	{
		__amx_show_activity = get_cvar_pointer("amx_show_activity");


		if (__amx_show_activity == 0)
		{
			__amx_show_activity = register_cvar("amx_show_activity", "2", 32);
		}
	}

	new buffer[512];
	new keyfmt[256];
	new i;

	switch (get_pcvar_num(__amx_show_activity))
	{
		case 5: 
		{
			while (i++ < MaxClients)
			{
				if (is_user_connected(i))
				{
					if (is_user_admin(i))
					{
						LookupLangKey(keyfmt, (sizeof(keyfmt)-1), KeyWithoutName, i);


						vformat(buffer, (sizeof(buffer)-1), keyfmt, 4);
						client_print(i, print_chat, "%s", buffer);
					}
				}
			}
		}
		case 4: 
		{
			while (i++ < MaxClients)
			{
				if (is_user_connected(i))
				{
					if (is_user_admin(i))
					{
						LookupLangKey(keyfmt, (sizeof(keyfmt)-1), KeyWithName, i);
						vformat(buffer, (sizeof(buffer)-1), keyfmt, 3);
						client_print(i, print_chat, "%s", buffer);
					}
				}
			}
		}
		case 3: 
		{
			while (i++ < MaxClients)
			{
				if (is_user_connected(i))
				{
					if (is_user_admin(i))
					{
						LookupLangKey(keyfmt, (sizeof(keyfmt)-1), KeyWithName, i);
						vformat(buffer, (sizeof(buffer)-1), keyfmt, 3);
					}
					else
					{
						LookupLangKey(keyfmt, (sizeof(keyfmt)-1), KeyWithoutName, i);


						vformat(buffer, (sizeof(buffer)-1), keyfmt, 4);
					}
					client_print(i, print_chat, "%s", buffer);
				}
			}
		}
		case 2: 
		{
			while (i++ < MaxClients)
			{
				if (is_user_connected(i))
				{
					LookupLangKey(keyfmt, (sizeof(keyfmt)-1), KeyWithName, i);
					vformat(buffer, (sizeof(buffer)-1), keyfmt, 3);
					client_print(i, print_chat, "%s", buffer);
				}
			}
		}
		case 1: 
		{
			while (i++ < MaxClients)
			{
				if (is_user_connected(i))
				{
					LookupLangKey(keyfmt, (sizeof(keyfmt)-1), KeyWithoutName, i);


					vformat(buffer, (sizeof(buffer)-1), keyfmt, 4);
					client_print(i, print_chat, "%s", buffer);
				}
			}
		}
	}
}













stock colored_menus()
{
	static ColoredMenus = -1;

	if (ColoredMenus == -1)
	{
		new const ModNames[][] = { "cstrike", "czero", "dmc", "dod", "tfc", "valve" };
		new ModName[32];

		get_modname(ModName, (sizeof(ModName)-1));

		for (new Iterator = 0; Iterator < sizeof(ModNames); Iterator++)
		{
			if (equal(ModName, ModNames[Iterator]))
			{
				ColoredMenus = 1;

				break;
			}
		}

		if (ColoredMenus == -1)
			ColoredMenus = 0;
	}

	return ColoredMenus;
}






stock cstrike_running()
{
	new mod_name[32];
	get_modname(mod_name, (sizeof(mod_name)-1));

	return (equal(mod_name, "cstrike") || equal(mod_name, "czero") || equal(mod_name, "csv15") || equal(mod_name, "cs13"));
}








stock is_running(const mod[])
{
	new mod_name[32];
	get_modname(mod_name, (sizeof(mod_name)-1));

	return equal(mod_name, mod);
}









