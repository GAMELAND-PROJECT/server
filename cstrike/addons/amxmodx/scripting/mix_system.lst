public native_get_prefix(iPluginID, iParamNum)
{
	set_string(1, g_ePluginSettings[szPrefix], get_param(2))
}

public native_get_username(iPluginID, iParamNum)
{
	if (iParamNum != 3)
	{
		log_error(10, "%s Invalid param num ! Valid: (PlayerID, Name[], Len)", g_ePluginSettings[szPrefix])
		return -1
	}
	new id = get_param(1)

	if(!is_user_connected(id))
	{
		log_error(10, "%s Player is not connected (%d)", g_ePluginSettings[szPrefix], id)
		return -1
	}

	set_string(2, g_szName[id], get_param(3))

	return 1
}


