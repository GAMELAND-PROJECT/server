	if(!g_eBooleans[bOvertime])
	{
		if(g_iScore[CT_SCORE] == (g_ePluginSettings[iMixEndRound] - 1 ))
		{
			iResult = CT_LAST
		}

		if(g_iScore[TERO_SCORE] == (g_ePluginSettings[iMixEndRound] - 1))
		{
			iResult = T_LAST
		}
	}

	return iResult
}

