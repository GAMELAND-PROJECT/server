public task_ask_player(id)
{
	id -= TASK_ASK

	new szTemp[64]

	formatex(szTemp, (sizeof(szTemp)-1), "\r%s \w%L", g_ePluginSettings[szPrefix], 0, "MENU_ASK_PLAYER")
	new menu = menu_create(szTemp, "handle_ask_menu")

	formatex(szTemp, (sizeof(szTemp)-1), "\y%L", 0, "ASK_MENU_SWITCH")
	menu_additem(menu, szTemp)

	formatex(szTemp, (sizeof(szTemp)-1), "\y%L", 0, "ASK_MENU_STAY")
	menu_additem(menu, szTemp)

	_MenuDisplay(id, menu)
}

public handle_ask_menu(id, menu, item)
{
	if(item == -3 || !((1 <= id <= 32) && is_user_connected(id)) || g_bVoted || g_eBooleans[bIsMixOn])
	{
		return _MenuExit(menu)
	}

	switch(item)
	{
		case 0:
		{
			g_iAnswer[SWITCH] += 1
		}
		case 1:
		{
			g_iAnswer[STAY] += 1
		}
	}

	CheckVotes(g_iAnswer)

	return _MenuExit(menu)
}

public CheckVotes(any:iAnswer[])
{
	if(iAnswer[SWITCH] > iAnswer[STAY])
	{
		g_iVote = 1
	}
	else if(iAnswer[SWITCH] < iAnswer[STAY])
	{
		g_iVote = 0
	}
	else if(iAnswer[SWITCH] == iAnswer[STAY])
	{
		g_iVote = 0
	}
	else 
	{
		g_iVote = 0
	}
}

