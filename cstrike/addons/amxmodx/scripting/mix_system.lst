public hook_say(id)
{
	if(!is_user_connected(id))
		return 0

	if(!g_eBooleans[bCanChat][id] && g_eBooleans[bIsMixOn])
	{
		if(!(get_user_flags(id) & read_flags(g_ePluginSettings[szAdminFlags])))
		{
			return 1
		}
		else if(get_user_flags(id) & read_flags(g_ePluginSettings[szAdminFlags]))
		{
			return 0
		}
	}

	new sArg[32], szMessage[180]
	read_argv(1, sArg, (sizeof(sArg)-1))
	read_args(szMessage, (sizeof(szMessage)-1))
	remove_quotes(szMessage)

	if(equal(szMessage, "hs1") || equal(szMessage, "/hs1") || equal(szMessage, ".hs1"))
	{
		clcmd_hs1(id)
		return 1
	}
	if(equal(szMessage, "hs0") || equal(szMessage, "/hs0") || equal(szMessage, ".hs0"))
	{
		clcmd_hs0(id)
		return 1
	}

	if(strlen(szMessage) != 0)
	{
		if(szMessage[0] == '/')
		{
			switch(szMessage[1])
			{
				case 's':
				{
					if(szMessage[2] == 'p' && szMessage[5] != 'a')
					{
						clcmd_move_spec(id, szMessage, (sizeof(szMessage)-1), 1)
						return 1
					}
				}
				case 't':
				{
					if(szMessage[2] == ' ')
					{
						clcmd_move_t(id, szMessage, (sizeof(szMessage)-1), 1)
						return 1
					}
				}
				case 'c':
				{
					if(szMessage[2] == 't')
					{
						clcmd_move_ct(id, szMessage, (sizeof(szMessage)-1), 1)
						return 1
					}
				}
				case 'p':
				{
					if(szMessage[2] == 'a' && szMessage[5] == ' ')
					{
						clcmd_passon(id, szMessage, 1)
						return 1
					}
				}
			}
		}

		new iPlayer, iPlayers[32], iNum
		get_players(iPlayers, iNum, "c")

		if(is_user_alive(id))
		{
			format(szMessage, (sizeof(szMessage)-1), "^3%n^1: %s", id, szMessage)
		}
		else
		{
			format(szMessage, (sizeof(szMessage)-1), "^1*[DEAD] ^3%n^1: %s", id, szMessage)
		}

		for(new i; i < iNum; i++)
		{
			iPlayer = iPlayers[i]

			client_print_color(iPlayer, id, szMessage)
		}
	}

	return 0
}

