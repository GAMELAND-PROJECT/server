		{
			client_print_color(id, id, "^4%s %L", g_ePluginSettings[szPrefix], 0, "MIX_SCORE_IS", 0, "CT_TEAM", g_iScore[CT_SCORE], 0, "TERO_TEAM", g_iScore[TERO_SCORE])
		}
		else
		{
			client_print_color(id, id, "^4%s %L", g_ePluginSettings[szPrefix], 0, "MIX_SCORE_IS_WITH_END", 0, "CT_TEAM", g_iScore[CT_SCORE], 0, "TERO_TEAM", g_iScore[TERO_SCORE])
		}
	}

	if(g_eOvertime[FirstOvertime] && !IsHalf() && !OvertimeFinished())
	{
		if(!g_eOvertime[SecondOvertime] && !g_eBooleans[bTeamSwap])
		{
			client_print_color(id, id, "^4%s %L", g_ePluginSettings[szPrefix], 0, "FIRST_OVERTIME_SCORE_IS", 0, "CT_TEAM", g_iOvertimeScore[CT_OVER_SCORE], 0, "TERO_TEAM", g_iOvertimeScore[TERO_OVER_SCORE])
		}
	}

	if(IsPreLastRound() && !g_eBooleans[bOvertime])
	{
		new szTemp[16]
		LastRoundUntilWin(szTemp, (sizeof(szTemp)-1))

		client_print_color(id, id, "^4%s %L", g_ePluginSettings[szPrefix], 0, "MIX_LAST_ROUND_FOR_X_TEAM", szTemp)
		client_print_color(id, id, "^4%s %L", g_ePluginSettings[szPrefix], 0, "MIX_SCORE_IS_WITH_END", 0, "CT_TEAM", g_iScore[CT_SCORE], 0, "TERO_TEAM", g_iScore[TERO_SCORE])
	}

	return 0
}

public clcmd_ct(id)
{
	new arg1[32]
	read_argv(1, arg1, (sizeof(arg1)-1))

	clcmd_move_ct(id, arg1, (sizeof(arg1)-1))

	return 1
}

stock clcmd_move_ct(id, szMessage[], iLen, IsSay = -1)
{
	if(!(get_user_flags(id) & read_flags(g_ePluginSettings[szAdminAccess])))
	{
		client_print_color(id, id, "^4%s %L", g_ePluginSettings[szPrefix], 0, "YOU_DONT_HAVE_ACCESS")
		return 1
	}

	new target

	if(IsSay)
	{
		replace_all(szMessage, iLen, "/ct ", "")
		replace_all(szMessage, iLen, "^"", "")
	}

	target = cmd_target(id, szMessage, (1<<1))

	if(!target)
	{
		client_print_color(id, id, "^4%s %L", g_ePluginSettings[szPrefix], 0, "PLAYER_NOT_FOUND")
		return 1
	}

	static iPlayer, iPlayers[32], iNum, szTeam[22]
	get_players(iPlayers, iNum, "ch")

	GetTeam(CT, szTeam, (sizeof(szTeam)-1))

	for(new i; i < iNum; i++)
	{
		iPlayer = iPlayers[i]

		if(id == iPlayer)
		{
			client_print_color(iPlayer, iPlayer, "^4%s %L", g_ePluginSettings[szPrefix], 0, "PLAYER_X_MOVED_X_BY_YOU", g_szName[target], szTeam)
		}
		else if(target == iPlayer)
		{
			client_print_color(iPlayer, iPlayer, "^4%s %L", g_ePluginSettings[szPrefix], 0, "YOU_WERE_MOVED_X_BY_X", szTeam, g_szName[id])
		}
		else
		{
			client_print_color(iPlayer, iPlayer, "^4%s %L", g_ePluginSettings[szPrefix], 0, "PLAYER_X_MOVED_X_BY_X", g_szName[target], szTeam, g_szName[id])
		}
	}

	rg_join_team(target, TEAM_CT)

	return 1
}

