stock SetGameDesc(MatchState:matchState)
{
	new szTemp[30]
	switch(matchState)
	{
		case MATCHSTATE_WARM:
		{
			formatex(szTemp, (sizeof(szTemp)-1), "%L", 0, "MATCHSTATE_WARM")
		}
		case MATCHSTATE_IN_MATCH:
		{
			formatex(szTemp, (sizeof(szTemp)-1), "%L", 0, "MATCHSTATE_IN_MATCH", g_iScore[CT_SCORE], g_iScore[TERO_SCORE])
		}
		case MATCHSTATE_KNIFE_ROUND:
		{
			formatex(szTemp, (sizeof(szTemp)-1), "%L", 0, "MATCHSTATE_KNIFE_ROUND")
		}
		case MATCHSTATE_OVERTIME:
		{
			formatex(szTemp, (sizeof(szTemp)-1), "%L", 0, "MATCHSTATE_OVERTIME", g_iOvertimeScore[CT_OVER_SCORE], g_iOvertimeScore[TERO_OVER_SCORE])
		}
	}

	set_member_game(m_GameDesc, szTemp)
}

