public __reapi_version_check(const majorVersion, const minorVersion)
{
	if (majorVersion != 5)
	{
		new temp[512];
		formatex(temp, sizeof temp - 1, "[ReAPI]: Api major version mismatch; expected %d, real %d", 5, majorVersion);
		set_fail_state(temp);
		return;
	}

	if (minorVersion < 29)
	{
		new temp[512];
		formatex(temp, sizeof temp - 1, "[ReAPI]: Api minor version mismatch; expected at least %d, real %d", 29, minorVersion);
		set_fail_state(temp);
		return;
	}
}
